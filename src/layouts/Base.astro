---
import "../styles/global.css";
import { copy, type Lang, langs, pathFor } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy[lang].lead} />
    <title>{copy[lang].title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header>
      <div class="shell">
        <a class="wordmark" href={pathFor(lang)}>Pascal Roose<span>.</span></a>
        <nav class="lang" aria-label="Language">
          {
            langs.map((l) => (
              <a href={pathFor(l)} hreflang={l} lang={l} aria-current={l === lang}>
                {l.toUpperCase()}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="shell"><slot /></main>
    <footer>
      <div class="shell">
        <span class="note">© {new Date().getFullYear()} Pascal Roose</span>
      </div>
    </footer>
  </body>
</html>
